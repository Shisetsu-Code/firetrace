{
  "name": "button-browser",
  "version": "1.1.0",
  "private": true,
  "description": "Navegador controlable con recortes y coordenadas de botones DOM y Pixi",
  "main": "src/server.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.cjs",
    "cli": "node src/cli.cjs",
    "browser:install": "playwright install chromium",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:unit": "node --test tests/commands.test.cjs"
  },
  "dependencies": {
    "playwright": "1.56.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "pixi.js": "6.5.2"
  }
}
